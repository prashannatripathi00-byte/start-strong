---
// SocialShare.astro — share buttons for article pages
interface Props {
  title: string;
  url: string;
}
const { title, url } = Astro.props;
const encoded = {
  url:   encodeURIComponent(url),
  title: encodeURIComponent(title),
};
---

<div class="social-share" role="group" aria-label="Share this article">
  <a
    href={`https://www.facebook.com/sharer/sharer.php?u=${encoded.url}`}
    class="share-btn share-btn--facebook"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on Facebook"
    data-platform="facebook"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
    </svg>
    Facebook
  </a>

  <a
    href={`https://twitter.com/intent/tweet?url=${encoded.url}&text=${encoded.title}`}
    class="share-btn share-btn--twitter"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on X (Twitter)"
    data-platform="twitter"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
    </svg>
    Share
  </a>

  <button
    class="share-btn share-btn--copy"
    type="button"
    aria-label="Copy article link"
    data-copy-url={url}
    data-platform="copy"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true">
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
    </svg>
    <span class="copy-label">Copy Link</span>
  </button>
</div>

<style>
  .social-share {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.55rem 1rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: var(--border-radius);
    text-decoration: none;
    cursor: pointer;
    border: 1.5px solid transparent;
    transition: background-color var(--transition), color var(--transition), border-color var(--transition);
    background: none;
    width: 100%;
  }

  .share-btn:focus-visible {
    outline: 3px solid var(--color-orange);
    outline-offset: 2px;
  }

  .share-btn--facebook {
    background-color: #1877f2;
    color: white;
  }
  .share-btn--facebook:hover {
    background-color: #1663c7;
    color: white;
  }

  .share-btn--twitter {
    background-color: var(--color-dark);
    color: white;
  }
  .share-btn--twitter:hover {
    background-color: #2d3748;
    color: white;
  }

  .share-btn--copy {
    background-color: var(--color-grey-light);
    color: var(--color-dark);
    border-color: var(--color-grey-light);
  }
  .share-btn--copy:hover {
    background-color: var(--color-orange);
    border-color: var(--color-orange);
    color: white;
  }
</style>

<script>
  document.querySelectorAll('.share-btn--copy').forEach(btn => {
    btn.addEventListener('click', async () => {
      const url = (btn as HTMLElement).dataset.copyUrl ?? window.location.href;
      const label = btn.querySelector('.copy-label');
      try {
        await navigator.clipboard.writeText(url);
        if (label) {
          label.textContent = 'Copied!';
          setTimeout(() => { label.textContent = 'Copy Link'; }, 2000);
        }
      } catch {
        // Clipboard API not available — fallback
        if (label) label.textContent = 'Copy failed';
      }

      // Track in GA4
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'share_click', {
          event_category: 'Social Share',
          event_label: 'copy_link',
        });
      }
    });
  });

  // Track share link clicks
  document.querySelectorAll('.share-btn[data-platform]').forEach(btn => {
    btn.addEventListener('click', () => {
      const platform = (btn as HTMLElement).dataset.platform;
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'share_click', {
          event_category: 'Social Share',
          event_label: platform,
        });
      }
    });
  });
</script>
