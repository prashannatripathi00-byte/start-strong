---
// blog/index.astro — Blog listing page with category filter
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [
  'All',
  'Beginner Running',
  'Training and Fitness',
  'Running Gear',
  'Motivation and Lifestyle',
];

const featured = allPosts.find(p => p.data.featured) ?? allPosts[0];
---

<BaseLayout
  title="Running Blog — Tips, Guides and Advice"
  description="Browse all Start Strong articles. Beginner running tips, training advice, gear guides and motivation — practical content for new and recreational runners."
>

  <!-- Blog Hero -->
  <section class="blog-hero bg-dark">
    <div class="container">
      <nav aria-label="Breadcrumb" class="breadcrumb breadcrumb--light">
        <ol role="list">
          <li><a href={base}>Home</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">Blog</li>
        </ol>
      </nav>
      <h1 class="blog-hero__title text-white">Running Tips, Guides &amp; Advice</h1>
      <p class="blog-hero__subtitle">
        Practical, readable articles for beginner and recreational runners.
        New content added regularly.
      </p>
    </div>
  </section>

  <!-- Search & Filter -->
  <section class="filter-bar bg-ivory">
    <div class="container">
      <div class="filter-bar__inner">
        <!-- Category tabs -->
        <div class="category-tabs" role="tablist" aria-label="Filter articles by category">
          {categories.map(cat => (
            <button
              class={`category-tab ${cat === 'All' ? 'category-tab--active' : ''}`}
              data-category={cat === 'All' ? 'all' : cat}
              role="tab"
              aria-selected={cat === 'All' ? 'true' : 'false'}
              type="button"
            >
              {cat}
            </button>
          ))}
        </div>

        <!-- Search -->
        <div class="blog-search">
          <label for="blog-search-input" class="sr-only">Search articles</label>
          <input
            type="search"
            id="blog-search-input"
            class="blog-search__input"
            placeholder="Search articles…"
            aria-label="Search articles"
          />
          <svg class="blog-search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" width="18" height="18">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Article -->
  {featured && (
    <section class="featured-post section--sm">
      <div class="container">
        <span class="section-header__eyebrow">Featured Article</span>
        <article class="featured-post__card">
          <div class="featured-post__image-wrap">
            {featured.data.image ? (
              <img
                src={featured.data.image}
                alt={featured.data.imageAlt ?? featured.data.title}
                class="featured-post__image"
                width="800"
                height="450"
                loading="eager"
              />
            ) : (
              <div class="featured-post__placeholder" aria-hidden="true">🏃</div>
            )}
          </div>
          <div class="featured-post__body">
            <a href={`${base}blog/?category=${featured.data.category.toLowerCase().replace(/\s+/g,'-').replace(/&/g,'and')}`} class="badge badge--orange">
              {featured.data.category}
            </a>
            <h2 class="featured-post__title">
              <a href={`${base}blog/${featured.slug}/`}>{featured.data.title}</a>
            </h2>
            <p class="featured-post__excerpt">{featured.data.description}</p>
            <div class="featured-post__meta">
              <time datetime={featured.data.pubDate.toISOString()}>
                {featured.data.pubDate.toLocaleDateString('en-IE', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              {featured.data.readingTime && <span>· {featured.data.readingTime} min read</span>}
            </div>
            <a href={`${base}blog/${featured.slug}/`} class="btn btn--primary">Read Article →</a>
          </div>
        </article>
      </div>
    </section>
  )}

  <!-- All Articles -->
  <section class="all-posts section--sm" aria-label="All articles">
    <div class="container">
      <div id="posts-grid" class="grid-3">
        {allPosts.map(post => (
          <div
            class="post-wrapper"
            data-category={post.data.category}
            data-title={post.data.title.toLowerCase()}
            data-tags={post.data.tags.join(' ').toLowerCase()}
          >
            <ArticleCard post={post} />
          </div>
        ))}
      </div>

      <!-- Empty state -->
      <div id="no-results" class="no-results" hidden>
        <p>No articles found matching your search.</p>
        <button class="btn btn--secondary btn--sm" id="clear-filters" type="button">Clear Filters</button>
      </div>

      <!-- Article count -->
      <p class="post-count" id="post-count" aria-live="polite">
        Showing <span id="count-number">{allPosts.length}</span> article{allPosts.length !== 1 ? 's' : ''}
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  /* Blog hero */
  .blog-hero { padding-block: var(--space-3xl); }
  .breadcrumb { margin-bottom: var(--space-lg); }
  .breadcrumb ol {
    display: flex; align-items: center; gap: var(--space-xs);
    list-style: none; padding: 0; margin: 0; font-size: 0.85rem;
  }
  .breadcrumb--light a { color: rgba(255,255,255,0.6); text-decoration: none; }
  .breadcrumb--light a:hover { color: var(--color-orange); }
  .breadcrumb--light li:last-child { color: rgba(255,255,255,0.4); }

  .blog-hero__title { font-size: clamp(1.8rem, 4vw, 2.75rem); margin-bottom: var(--space-md); }
  .blog-hero__subtitle { color: rgba(255,255,255,0.65); font-size: 1.05rem; max-width: 520px; margin: 0; }

  /* Filter bar */
  .filter-bar { padding-block: var(--space-lg); border-bottom: 1px solid var(--color-grey-light); }
  .filter-bar__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-lg); flex-wrap: wrap; }

  .category-tabs { display: flex; gap: var(--space-xs); flex-wrap: wrap; }

  .category-tab {
    padding: 0.4rem 0.9rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    background: none;
    border: 1.5px solid var(--color-grey-light);
    border-radius: 50px;
    cursor: pointer;
    color: var(--color-grey);
    transition: all var(--transition);
  }
  .category-tab:hover { border-color: var(--color-orange); color: var(--color-orange); }
  .category-tab--active {
    background-color: var(--color-orange);
    border-color: var(--color-orange);
    color: var(--color-white);
  }

  /* Search */
  .blog-search { position: relative; }
  .blog-search__input {
    padding-right: 2.5rem;
    width: 240px;
    border-radius: 50px;
    font-size: 0.875rem;
  }
  .blog-search__icon {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-grey);
    pointer-events: none;
  }

  /* Featured post */
  .featured-post__card {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-3xl);
    align-items: center;
    background: var(--color-white);
    border: 1px solid var(--color-grey-light);
    border-radius: var(--border-radius-xl);
    overflow: hidden;
  }
  .featured-post__image-wrap { overflow: hidden; }
  .featured-post__image { width: 100%; aspect-ratio: 16/9; object-fit: cover; }
  .featured-post__placeholder {
    width: 100%; aspect-ratio: 16/9;
    background: linear-gradient(135deg, var(--color-dark), var(--color-grey));
    display: flex; align-items: center; justify-content: center;
    font-size: 5rem;
  }
  .featured-post__body { padding: var(--space-2xl); }
  .featured-post__title { font-size: clamp(1.25rem, 2.5vw, 1.75rem); margin-block: var(--space-md); }
  .featured-post__title a { color: var(--color-dark); text-decoration: none; }
  .featured-post__title a:hover { color: var(--color-orange); }
  .featured-post__excerpt { color: var(--color-grey); margin-bottom: var(--space-lg); }
  .featured-post__meta {
    font-size: 0.85rem; color: var(--color-grey);
    margin-bottom: var(--space-lg);
    display: flex; gap: var(--space-sm);
  }

  /* Posts */
  .post-count {
    font-size: 0.85rem; color: var(--color-grey);
    margin-top: var(--space-xl); text-align: center;
  }

  .no-results {
    text-align: center; padding: var(--space-3xl);
    background: var(--color-ivory); border-radius: var(--border-radius-lg);
    color: var(--color-grey);
  }
  .no-results p { margin-bottom: var(--space-md); }

  @media (max-width: 768px) {
    .featured-post__card { grid-template-columns: 1fr; }
    .featured-post__body { padding: var(--space-xl); }
    .blog-search__input { width: 180px; }
    .filter-bar__inner { flex-direction: column; align-items: flex-start; }
    .blog-search { width: 100%; }
    .blog-search__input { width: 100%; }
  }
</style>

<script>
  const postWrappers = Array.from(document.querySelectorAll('.post-wrapper')) as HTMLElement[];
  const tabs = document.querySelectorAll('.category-tab');
  const searchInput = document.getElementById('blog-search-input') as HTMLInputElement;
  const noResults = document.getElementById('no-results');
  const countEl = document.getElementById('count-number');
  const clearBtn = document.getElementById('clear-filters');

  let activeCategory = 'all';
  let searchTerm = '';

  function filterPosts() {
    let visible = 0;
    postWrappers.forEach(wrapper => {
      const cat   = wrapper.dataset.category ?? '';
      const title = wrapper.dataset.title ?? '';
      const tags  = wrapper.dataset.tags ?? '';

      const matchCat    = activeCategory === 'all' || cat === activeCategory;
      const matchSearch = searchTerm === '' || title.includes(searchTerm) || tags.includes(searchTerm);
      const show = matchCat && matchSearch;

      wrapper.hidden = !show;
      if (show) visible++;
    });

    if (countEl) countEl.textContent = String(visible);
    if (noResults) noResults.hidden = visible > 0;

    // GA4 search tracking
    if (searchTerm && typeof window.gtag === 'function') {
      window.gtag('event', 'search', { search_term: searchTerm });
    }
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => { t.classList.remove('category-tab--active'); t.setAttribute('aria-selected', 'false'); });
      tab.classList.add('category-tab--active');
      tab.setAttribute('aria-selected', 'true');
      activeCategory = (tab as HTMLElement).dataset.category ?? 'all';
      filterPosts();
    });
  });

  let searchTimeout: ReturnType<typeof setTimeout>;
  searchInput?.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      searchTerm = searchInput.value.toLowerCase().trim();
      filterPosts();
    }, 300);
  });

  clearBtn?.addEventListener('click', () => {
    searchInput.value = '';
    searchTerm = '';
    activeCategory = 'all';
    tabs.forEach((t, i) => {
      t.classList.toggle('category-tab--active', i === 0);
      t.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
    });
    filterPosts();
  });

  // URL-based category preselection (e.g. ?category=beginner-running)
  const urlParams = new URLSearchParams(window.location.search);
  const preselect = urlParams.get('category');
  if (preselect) {
    tabs.forEach(tab => {
      const tabCat = (tab as HTMLElement).dataset.category ?? '';
      const slugMatch = tabCat.toLowerCase().replace(/\s+/g, '-').replace(/&/g, 'and') === preselect;
      tab.classList.toggle('category-tab--active', slugMatch);
      tab.setAttribute('aria-selected', slugMatch ? 'true' : 'false');
      if (slugMatch) activeCategory = tabCat;
    });
    filterPosts();
  }
</script>
