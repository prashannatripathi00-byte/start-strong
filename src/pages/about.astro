---
// about.astro — About Start Strong
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import { url } from '../utils/url';
---

<BaseLayout
  title="About Start Strong — Our Mission and Values"
  description="Learn about Start Strong — our mission to make running accessible, our editorial values, and how we create content that helps beginners take their first steps."
>

  <!-- Hero -->
  <section class="page-hero bg-dark">
    <div class="container">
      <nav aria-label="Breadcrumb" class="breadcrumb breadcrumb--light">
        <ol role="list">
          <li><a href={url('')}>Home</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">About</li>
        </ol>
      </nav>
      <span class="page-hero__eyebrow">About Us</span>
      <h1 class="page-hero__title text-white">Making Running Accessible<br/>for Everyone</h1>
      <p class="page-hero__subtitle">
        Start Strong exists to remove the barriers between a new runner and their first run.
      </p>
    </div>
  </section>

  <div class="about-content">
    <div class="container container--narrow">

      <!-- Mission -->
      <section class="about-section" id="mission">
        <h2>Our Mission</h2>
        <blockquote class="mission-quote">
          "To make running more accessible through practical information, encouragement
          and beginner-friendly guidance."
        </blockquote>
        <p>
          Running is one of the most effective forms of exercise available. It requires
          no gym membership, minimal equipment and very little prior fitness. Yet many
          people who want to start running are held back — by uncertainty about where
          to begin, concerns about whether they are fit enough, or a lack of accessible
          and credible information.
        </p>
        <p>
          Start Strong was created to address that gap. We provide practical running
          information that is honest, straightforward and specifically written for people
          who are new to running or returning after a long break.
        </p>
      </section>

      <!-- Vision -->
      <section class="about-section" id="vision">
        <h2>Our Vision</h2>
        <p>
          We want every person who visits Start Strong to leave with something they
          can act on immediately — whether that is a training plan, a gear recommendation,
          a piece of motivational advice, or simply the confidence to lace up and step outside.
        </p>
        <p>
          Running is not just exercise. It is a source of consistency, mental clarity,
          community and personal achievement. We believe those benefits should be accessible
          to anyone who wants them — regardless of current fitness level, age or experience.
        </p>
      </section>

      <!-- Who we're for -->
      <section class="about-section" id="audience">
        <h2>Who We Write For</h2>
        <p>Start Strong is designed primarily for:</p>
        <div class="audience-grid">
          {[
            { icon: '🏃', label: 'Complete beginners', desc: 'People who have never run regularly and want to know where to start.' },
            { icon: '🔄', label: 'Returning runners', desc: 'Individuals who ran previously and are getting back into it after a break.' },
            { icon: '🌱', label: 'Recreational runners', desc: 'Those who run for health, enjoyment and wellbeing rather than competition.' },
            { icon: '💡', label: 'Curious learners', desc: 'People who want to understand running, gear and training more deeply.' },
          ].map(item => (
            <div class="audience-card">
              <span class="audience-card__icon" aria-hidden="true">{item.icon}</span>
              <div>
                <h4 class="audience-card__label">{item.label}</h4>
                <p class="audience-card__desc">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
        <p>
          We do not primarily target elite or competitive runners, although experienced
          runners may find our gear and training content useful.
        </p>
      </section>

      <!-- Editorial standards -->
      <section class="about-section" id="editorial-standards">
        <h2>Editorial Standards</h2>
        <p>
          Our content is written and reviewed with the following principles:
        </p>
        <ul class="principles-list">
          <li>
            <strong>Accuracy first.</strong>
            We base our content on established running and fitness principles. We cite
            sources where specific factual claims are made and acknowledge when guidance
            is general rather than individually applicable.
          </li>
          <li>
            <strong>No invented credentials.</strong>
            We do not fabricate expert endorsements, certifications, customer testimonials
            or performance statistics. Content is attributed clearly.
          </li>
          <li>
            <strong>No invented experts or quotes.</strong>
            We do not create fictional running coaches, physiotherapists or specialists.
            If expert guidance is referenced, the source is identified.
          </li>
          <li>
            <strong>Health safety.</strong>
            General fitness content on Start Strong is not a substitute for personalised
            medical advice. We include appropriate disclaimers on training content.
          </li>
          <li>
            <strong>Transparency about limitations.</strong>
            Where knowledge is incomplete or where recommendations are general rather
            than universal, we say so directly.
          </li>
          <li>
            <strong>Regular review.</strong>
            Running research evolves. We aim to update content when the evidence base
            changes materially.
          </li>
        </ul>
      </section>

      <!-- Affiliate disclosure -->
      <section class="about-section" id="affiliate-disclosure">
        <h2>Affiliate Disclosure</h2>
        <p>
          Start Strong may in future earn a commission through affiliate links — links
          to third-party products or services from which we receive a percentage of
          purchases made through those links.
        </p>
        <p>
          <strong>Our commitment:</strong>
        </p>
        <ul>
          <li>Affiliate relationships will only be entered into with brands and products
              that are genuinely relevant to our audience.</li>
          <li>Affiliate links will always be clearly identified at the page level.</li>
          <li>Product inclusion and recommendations will not be paid for by brands.</li>
          <li>Editorial content will remain independent of commercial relationships.</li>
        </ul>
        <p>
          At the time of writing, no active affiliate agreements are in place.
          This page will be updated when affiliate relationships are established.
        </p>
      </section>

      <!-- Accessibility -->
      <section class="about-section" id="accessibility">
        <h2>Commitment to Accessibility</h2>
        <p>
          Start Strong is designed to be usable by as wide an audience as possible.
          Our accessibility commitments include:
        </p>
        <ul>
          <li>Readable typography with clear contrast ratios</li>
          <li>Semantic HTML that supports screen readers</li>
          <li>Keyboard-navigable interface</li>
          <li>Alternative text for informative images</li>
          <li>Responsive design across device sizes</li>
          <li>Reduced-motion support for users with vestibular conditions</li>
        </ul>
        <p>
          If you encounter an accessibility issue on Start Strong, please
          <a href={url('contact/')}>get in touch</a> and we will address it.
          Full WCAG compliance validation requires expert accessibility review and
          assistive technology testing beyond automated tools.
        </p>
      </section>

      <!-- Brand independence note -->
      <section class="about-section" id="independence">
        <h2>Brand Independence</h2>
        <p>
          Start Strong is an independent running information platform.
          It is not affiliated with, endorsed by, sponsored by or in any way
          connected to Nike, Adidas, Asics, New Balance, or any other sportswear
          brand referenced on this website.
        </p>
        <p>
          Any brand names mentioned are used purely for informational and educational
          purposes. Inclusion does not imply endorsement or commercial relationship.
        </p>
      </section>

    </div>
  </div>

  <CTASection
    heading="Join Us on the Journey"
    subtext="Start Strong is here for every step of your running journey — from the very first one."
    primaryLabel="Start Running Guide"
    primaryHref="start-running/"
    secondaryLabel="Get in Touch"
    secondaryHref="contact/"
    gaLabel="about_bottom"
  />

</BaseLayout>

<style>
  .page-hero { padding-block: var(--space-4xl); }
  .breadcrumb { margin-bottom: var(--space-lg); }
  .breadcrumb ol { display: flex; align-items: center; gap: var(--space-xs); list-style: none; padding: 0; margin: 0; font-size: 0.85rem; }
  .breadcrumb--light a { color: rgba(255,255,255,0.6); text-decoration: none; }
  .breadcrumb--light a:hover { color: var(--color-orange); }
  .breadcrumb--light li:last-child { color: rgba(255,255,255,0.4); }
  .page-hero__eyebrow {
    display: block; font-family: var(--font-heading); font-size: 0.8rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-orange); margin-bottom: var(--space-sm);
  }
  .page-hero__title { font-size: clamp(2rem, 5vw, 3.25rem); margin-bottom: var(--space-lg); }
  .page-hero__subtitle { font-size: 1.1rem; color: rgba(255,255,255,0.7); max-width: 560px; margin: 0; line-height: 1.65; }

  .about-content { padding-block: var(--space-4xl); }
  .about-section { margin-bottom: var(--space-4xl); }
  .about-section h2 { margin-bottom: var(--space-lg); padding-bottom: var(--space-sm); border-bottom: 2px solid var(--color-grey-light); }
  .about-section p { color: var(--color-grey-dark); line-height: 1.75; }

  .mission-quote {
    font-size: 1.25rem; font-style: italic; color: var(--color-dark);
    border-left: 4px solid var(--color-orange);
    padding: var(--space-lg) var(--space-xl);
    background: var(--color-ivory);
    border-radius: 0 var(--border-radius) var(--border-radius) 0;
    margin-block: var(--space-xl);
    line-height: 1.6;
  }

  .audience-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-md); margin-block: var(--space-xl); }
  .audience-card { background: var(--color-ivory); border: 1px solid var(--color-grey-light); border-radius: var(--border-radius); padding: var(--space-lg); display: flex; gap: var(--space-md); align-items: flex-start; }
  .audience-card__icon { font-size: 1.75rem; flex-shrink: 0; }
  .audience-card__label { font-size: 1rem; margin-bottom: var(--space-xs); }
  .audience-card__desc { font-size: 0.875rem; color: var(--color-grey); line-height: 1.55; margin: 0; }

  .principles-list { padding-left: var(--space-xl); color: var(--color-grey-dark); }
  .principles-list li { margin-bottom: var(--space-md); line-height: 1.65; }

  @media (max-width: 640px) {
    .audience-grid { grid-template-columns: 1fr; }
  }
</style>
