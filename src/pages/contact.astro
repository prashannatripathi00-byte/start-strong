---
// contact.astro — Contact page
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

// Set PUBLIC_CONTACT_EMAIL in your .env file (local) or as a GitHub Actions
// repository variable before going live. When not set the email section shows
// a configuration notice instead of a broken mailto: link.
const CONTACT_EMAIL = import.meta.env.PUBLIC_CONTACT_EMAIL ?? '';
const emailConfigured = CONTACT_EMAIL.length > 0 && !CONTACT_EMAIL.includes('example.com');
---

<BaseLayout
  title="Contact Start Strong"
  description="Get in touch with the Start Strong team. Questions, content suggestions, or feedback about our running guides — we'd love to hear from you."
>

  <section class="page-hero bg-dark">
    <div class="container">
      <nav aria-label="Breadcrumb" class="breadcrumb breadcrumb--light">
        <ol role="list">
          <li><a href={base}>Home</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">Contact</li>
        </ol>
      </nav>
      <span class="page-hero__eyebrow">Get in Touch</span>
      <h1 class="page-hero__title text-white">Contact Us</h1>
      <p class="page-hero__subtitle">Questions, feedback or content ideas — we are happy to hear from you.</p>
    </div>
  </section>

  <section class="contact-content">
    <div class="container">
      <div class="contact-grid">

        <!-- Contact info -->
        <div class="contact-info">
          <h2>How to Reach Us</h2>
          <p>
            Start Strong is a small independent running content platform. The best way
            to contact us is by email. We aim to respond to all messages within a few
            business days.
          </p>

          <div class="contact-methods">
            <div class="contact-method">
              <div class="contact-method__icon" aria-hidden="true">✉️</div>
              <div>
                <h3 class="contact-method__label">Email</h3>
                {emailConfigured ? (
                  <>
                    <a href={`mailto:${CONTACT_EMAIL}`} class="contact-method__value">
                      {CONTACT_EMAIL}
                    </a>
                    <p class="contact-method__note">
                      For general enquiries, content suggestions and reader questions.
                    </p>
                  </>
                ) : (
                  <p class="contact-method__note contact-method__note--notice">
                    A contact email address will be published here once the domain and inbox
                    are verified. In the meantime, please check back shortly.
                  </p>
                )}
              </div>
            </div>
          </div>

          <h3>What Can You Contact Us About?</h3>
          <ul class="contact-topics">
            <li>Questions about the content on this website</li>
            <li>Suggestions for new articles or topics</li>
            <li>Corrections or updates to existing content</li>
            <li>Accessibility concerns or technical issues</li>
            <li>Media or collaboration enquiries</li>
            <li>Feedback on the Start Strong running guides</li>
          </ul>

          <!-- Social media links — update once real accounts exist -->
          <div class="contact-social">
            <h3>Find Us Online</h3>
            <p class="social-note">
              Our social media profiles are being set up. Links will appear here
              once our accounts are active.
            </p>
            <div class="social-placeholders">
              <span class="social-placeholder">Instagram — coming soon</span>
              <span class="social-placeholder">Facebook — coming soon</span>
              <span class="social-placeholder">YouTube — coming soon</span>
            </div>
          </div>

          <!-- Privacy note -->
          <div class="privacy-note">
            <h3>Privacy</h3>
            <p>
              Any information you share via email will be used solely to respond to
              your enquiry. It will not be shared with third parties or added to
              marketing lists without your consent.
              See our <a href={`${base}privacy-policy/`}>Privacy Policy</a> for details.
            </p>
          </div>
        </div>

        <!-- FAQ -->
        <div class="contact-faq">
          <h2>Frequently Asked Questions</h2>
          <div class="faq-list">
            {[
              {
                q: 'Is the content on Start Strong free?',
                a: 'Yes. All guides, training plans and articles on Start Strong are freely accessible. No subscription or payment is required.'
              },
              {
                q: 'Can you give me personalised training advice?',
                a: 'Start Strong provides general educational content rather than individualised training programmes. For personalised fitness planning, consult a qualified coach or physiotherapist.'
              },
              {
                q: 'Can I suggest a topic for a new article?',
                a: 'Absolutely. If you have a running question that the site does not yet cover, we welcome suggestions. Email us with your idea.'
              },
              {
                q: 'Are the running plans safe for everyone?',
                a: 'Our training plans are general educational frameworks rather than medically personalised programmes. We always recommend consulting a healthcare professional before beginning a new exercise regime, particularly if you have an existing health condition.'
              },
              {
                q: 'Do you have affiliate partnerships?',
                a: 'Not currently. When affiliate relationships are established in future, they will be clearly disclosed on the relevant pages. See our affiliate disclosure policy on the About page.'
              },
              {
                q: 'Can I republish or share your content?',
                a: 'You are welcome to share links to Start Strong articles. Republishing full articles without permission is not permitted. For media enquiries, get in touch by email.'
              },
            ].map(item => (
              <details class="faq-item">
                <summary class="faq-item__question">{item.q}</summary>
                <p class="faq-item__answer">{item.a}</p>
              </details>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero { padding-block: var(--space-4xl); }
  .breadcrumb { margin-bottom: var(--space-lg); }
  .breadcrumb ol { display: flex; align-items: center; gap: var(--space-xs); list-style: none; padding: 0; margin: 0; font-size: 0.85rem; }
  .breadcrumb--light a { color: rgba(255,255,255,0.6); text-decoration: none; }
  .breadcrumb--light a:hover { color: var(--color-orange); }
  .breadcrumb--light li:last-child { color: rgba(255,255,255,0.4); }
  .page-hero__eyebrow {
    display: block; font-family: var(--font-heading); font-size: 0.8rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-orange); margin-bottom: var(--space-sm);
  }
  .page-hero__title { font-size: clamp(2rem, 5vw, 3.25rem); margin-bottom: var(--space-lg); }
  .page-hero__subtitle { font-size: 1.1rem; color: rgba(255,255,255,0.7); max-width: 560px; margin: 0; line-height: 1.65; }

  .contact-content { padding-block: var(--space-4xl); }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3xl); align-items: start; }

  .contact-info h2, .contact-faq h2 { margin-bottom: var(--space-xl); }
  .contact-info p { color: var(--color-grey-dark); line-height: 1.75; margin-bottom: var(--space-lg); }
  .contact-info h3 { margin-top: var(--space-xl); margin-bottom: var(--space-md); font-size: 1.1rem; }

  .contact-methods { margin-block: var(--space-xl); }
  .contact-method { display: flex; gap: var(--space-lg); align-items: flex-start; padding: var(--space-lg); background: var(--color-ivory); border-radius: var(--border-radius-lg); border: 1px solid var(--color-grey-light); }
  .contact-method__icon { font-size: 2rem; flex-shrink: 0; }
  .contact-method__label { font-family: var(--font-heading); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-grey); margin-bottom: var(--space-xs); }
  .contact-method__value { font-size: 1.1rem; font-weight: 600; color: var(--color-orange); }
  .contact-method__note { font-size: 0.875rem; color: var(--color-grey); margin: var(--space-xs) 0 0; }
  .contact-method__note--notice {
    color: var(--color-grey-dark);
    font-style: italic;
    border-left: 3px solid var(--color-orange);
    padding-left: var(--space-sm);
  }

  .contact-topics { color: var(--color-grey-dark); }
  .contact-topics li { margin-bottom: var(--space-sm); }

  .contact-social { margin-top: var(--space-xl); }
  .social-note { font-size: 0.875rem; color: var(--color-grey); }
  .social-placeholders { display: flex; flex-direction: column; gap: var(--space-xs); margin-top: var(--space-md); }
  .social-placeholder { font-size: 0.85rem; color: var(--color-grey); font-style: italic; }

  .privacy-note {
    margin-top: var(--space-xl); padding: var(--space-lg);
    background: var(--color-ivory); border-radius: var(--border-radius);
    border-left: 3px solid var(--color-grey-light);
  }
  .privacy-note h3 { font-size: 1rem; margin-bottom: var(--space-sm); }
  .privacy-note p { font-size: 0.875rem; color: var(--color-grey); margin: 0; }

  /* FAQ */
  .faq-list { display: flex; flex-direction: column; gap: var(--space-sm); }
  .faq-item {
    background: var(--color-white); border: 1px solid var(--color-grey-light);
    border-radius: var(--border-radius); overflow: hidden;
  }
  .faq-item__question {
    padding: var(--space-lg); font-family: var(--font-heading); font-size: 0.95rem;
    font-weight: 600; cursor: pointer; list-style: none;
    display: flex; align-items: center; justify-content: space-between;
    color: var(--color-dark);
  }
  .faq-item__question::after { content: '+'; font-size: 1.25rem; color: var(--color-orange); transition: transform var(--transition); }
  .faq-item[open] .faq-item__question::after { transform: rotate(45deg); }
  .faq-item__question:hover { background: var(--color-ivory); }
  .faq-item__question::-webkit-details-marker { display: none; }
  .faq-item__answer { padding: 0 var(--space-lg) var(--space-lg); font-size: 0.9rem; color: var(--color-grey-dark); line-height: 1.65; margin: 0; }

  @media (max-width: 1024px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
