# ─────────────────────────────────────────────────────────────────────────────
# Start Strong — environment variables
#
# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored; `.env.example` is committed as documentation.
# ─────────────────────────────────────────────────────────────────────────────

# Full site URL used for sitemap, canonical and Open Graph tags.
# GitHub Pages sub-path example:  https://yourusername.github.io/start-strong
# Custom domain example:          https://www.startstrong.run
PUBLIC_SITE_URL=https://yourusername.github.io/start-strong

# Base path.  Must match the path segment in PUBLIC_SITE_URL.
# GitHub Pages sub-path:  /start-strong
# Custom domain (root):   /
PUBLIC_BASE_PATH=/start-strong

# Google Analytics 4 Measurement ID.
# Obtain from: Google Analytics → Admin → Data Streams → your stream.
# Leave blank (or remove this line) to disable analytics entirely.
PUBLIC_GA_MEASUREMENT_ID=

# Contact email address shown on the Contact page.
# Must be a verified, working inbox before publishing.
# Leave blank to show a "contact coming soon" notice instead of a mailto link.
PUBLIC_CONTACT_EMAIL=
