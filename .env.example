# ─────────────────────────────────────────────────────────────────────────────
# Start Strong — environment variables
#
# Copy this file to `.env` for local development and fill in your values.
# `.env` is git-ignored; `.env.example` is committed as documentation.
#
# For Netlify deployment, set these in the Netlify dashboard:
#   Site → Site configuration → Environment variables
# OR keep them in netlify.toml [build.environment] (already configured).
# ─────────────────────────────────────────────────────────────────────────────

# ── Local development ─────────────────────────────────────────────────────────
# Full site URL used for sitemap, canonical and Open Graph tags.
# GitHub Pages sub-path example:  https://yourusername.github.io/start-strong
# Netlify example:                https://startstrongyour.netlify.app
# Local dev:                      http://localhost:4321
PUBLIC_SITE_URL=http://localhost:4321

# Base path — must match the path segment in PUBLIC_SITE_URL.
# GitHub Pages sub-path:  /start-strong
# Netlify / custom domain (root):   /
PUBLIC_BASE_PATH=/

# ── Google Analytics 4 ────────────────────────────────────────────────────────
# Measurement ID from: GA4 → Admin → Data Streams → your web stream → Measurement ID
# Leave blank (or remove this line) to disable analytics and hide the consent banner.
# Netlify production value is already set in netlify.toml.
PUBLIC_GA_MEASUREMENT_ID=G-NT68W9PQTW

# ── Contact ───────────────────────────────────────────────────────────────────
# Shown on the Contact page as a mailto link.
# Leave blank to show a "contact coming soon" notice instead.
PUBLIC_CONTACT_EMAIL=
